# Production environment variables for Express Backend on cPanel Node.js App
PORT=4000
NODE_ENV=production
# PostgreSQL database connection string (e.g. from Supabase, Neon, Render, or external PostgreSQL provider)
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public
# Frontend domain allowed by CORS
CLIENT_ORIGIN=https://yourdomain.com
