generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Questionnaire {
  id          String       @id @default(uuid())
  code        String
  name        String
  version     String
  language    String
  isActive    Boolean      @default(true)
  questions   Question[]
  assessments Assessment[]

  @@unique([code, version, language])
}

model Question {
  id              String @id @default(uuid())
  questionnaireId String
  questionNumber  Int
  questionText    String

  questionnaire Questionnaire      @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  options       AnswerOption[]
  answers       AssessmentAnswer[]

  @@unique([questionnaireId, questionNumber])
}

model AnswerOption {
  id          String @id @default(uuid())
  questionId  String
  optionText  String
  scoreValue  Int
  optionOrder Int

  question Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AssessmentAnswer[]

  @@unique([questionId, optionOrder])
}

model Patient {
  id String @id @default(uuid())

  // Legacy fields retained for existing records.
  fullName String?
  age      Int?

  contactNumber String?
  ageGroup      String
  maritalStatus String
  tobaccoUse    String
  conditions    String[] @default([])

  adultConfirmed Boolean @default(false)
  consent        Boolean @default(false)

  createdAt   DateTime     @default(now())
  assessments Assessment[]
}

model Assessment {
  id              String   @id @default(uuid())
  patientId       String
  questionnaireId String
  totalScore      Int
  interpretation  String   @default("PENDING_REVIEW")
  status          String   @default("COMPLETED")
  completedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  // Secure report access
  reportAccessTokenHash String?   @unique
  reportAccessExpiresAt DateTime?

  patient       Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  questionnaire Questionnaire      @relation(fields: [questionnaireId], references: [id], onDelete: Restrict)
  answers       AssessmentAnswer[]
}

model AssessmentAnswer {
  id             String   @id @default(uuid())
  assessmentId   String
  questionId     String
  answerOptionId String
  scoreValue     Int
  createdAt      DateTime @default(now())

  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question     Question     @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answerOption AnswerOption @relation(fields: [answerOptionId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, questionId])
}
